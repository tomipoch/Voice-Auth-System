# Voice Biometrics API - Environment Variables
# Copy to .env and adjust values (see apps/backend/README.md).

# ===================
# Database Configuration
# ===================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=voice_biometrics
DB_USER=voice_user
DB_PASSWORD=your_secure_password_here

# ===================
# API Configuration
# ===================
ENV=development  # development | production

# ===================
# Security
# ===================
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your_secret_key_here

# Encryption key for voice embeddings (32 bytes, URL-safe base64). Required in
# production (the API refuses to start without it there).
# Generate with: python -c "import secrets, base64; print(base64.urlsafe_b64encode(secrets.token_bytes(32)).decode())"
EMBEDDING_ENCRYPTION_KEY=your_embedding_encryption_key_here

# ===================
# pgAdmin (optional, dev only)
# ===================
# Used by docker-compose.yml. Change the default before exposing pgAdmin
# outside localhost.
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin

# ===================
# CORS Configuration
# ===================
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:5173

# ===================
# ML Models
# ===================
MODEL_CACHE_DIR=./models
# Optional: override the ASR model (default: wav2vec2_asr_es)
# ASR_MODEL=wav2vec2_asr_es

# ===================
# Biometric Thresholds
# ===================
SIMILARITY_THRESHOLD=0.60
ANTI_SPOOFING_THRESHOLD=0.5

# ===================
# Rate Limiting
# ===================
RATE_LIMIT=100/minute

# ===================
# Testing
# ===================
TESTING=False