[flake8]
max-line-length = 88
extend-ignore =
    # E203: whitespace before ':' (conflicts with black slicing notation)
    E203,
    # E501: line too long (handled by black's line-length = 88; the
    # E501 warnings seen with default flake8 are noise given the
    # project's black configuration)
    E501,
    # W503: line break before binary operator (black prefers this)
    W503,
    # E402: module level import not at top of file (kept for lazy
    # imports inside if-TESTING branches, see e.g. main.py)
    E402
exclude =
    .venv,
    venv,
    htmlcov,
    __pycache__,
    tests/manual
