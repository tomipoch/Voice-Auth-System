# Voice Biometrics Frontend Configuration

# API Configuration
VITE_API_URL=http://localhost:8000

# Development Mode
VITE_NODE_ENV=development

# Mock Data (desarrolladores)
VITE_ENABLE_MOCK_DATA=false

# Audio Configuration
VITE_AUDIO_SAMPLE_RATE=16000
VITE_AUDIO_MAX_DURATION=10

# Toast Configuration
VITE_TOAST_DURATION=3000