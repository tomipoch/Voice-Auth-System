# =========================
# Root environment variables
# Used by docker-compose.yml (api service) and pgAdmin.
# Copy to .env in the repo root to override the defaults.
# =========================

# Database
DATABASE_URL=postgresql://voice_user:voice_password@postgres:5432/voice_biometrics

# pgAdmin (optional, dev only)
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change_me_pgadmin